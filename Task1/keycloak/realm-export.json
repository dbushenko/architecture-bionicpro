  "components": {
    "org.keycloak.services.managers.LDAPServerCapabilities": [],
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap-provider",
        "providerId": "ldap",
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "username-attribute-mapper",
              "providerId": "user-attribute-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.attribute": ["uid"],
                "is.mandatory.in.ldap": ["true"],
                "read.only": ["true"],
                "user.model.attribute": ["username"]
              }
            },
            {
              "name": "full name mapper",
              "providerId": "full-name-ldap-mapper",
              "subComponents": {},
              "config": {
                "ldap.full.name.attribute": ["cn"],
                "ldap.firstName.attribute": ["givenName"],
                "always.read.fullName.from.ldap": ["false"],
                "readOnly": ["true"]
              }
            },
            {
              "name": "group-mapper",
              "providerId": "group-ldap-mapper",
              "subComponents": {},
              "config": {
                "always.read.roles.from.ldap": ["false"],
                "readOnly": ["true"],
                "role.name": ["${group.name}"],
                "roles.ldap.attribute": ["cn"],
                "membership.ldap.attribute": ["member"],
                "membership.object.classes": ["groupOfNames"],
                "groups.dn": ["ou=Groups,dc=bionicpro,dc=com"],
                "mode": ["READ_ONLY"],
                "user.roles.retrieve.strategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"],
                "group.name.ldap.attribute": ["cn"],
                "preserve.group.inheritance": ["false"],
                "ignore.missing.groups": ["false"],
                "membership.user.ldap.attribute": ["uid"]
              }
            }
          ]
        },
        "config": {
          "priority": ["0"],
          "enabled": ["true"],
          "cachePolicy": ["DEFAULT"],
          "connectionUrl": ["ldap://ldap:389"],
          "usersDn": ["ou=People,dc=bionicpro,dc=com"],
          "usernameLDAPAttribute": ["uid"],
          "rdnLDAPAttribute": ["uid"],
          "uuidLDAPAttribute": ["entryUUID"],
          "userObjectClasses": ["inetOrgPerson"],
          "connectionPooling": ["true"],
          "authType": ["simple"],
          "bindDn": ["cn=admin,dc=bionicpro,dc=com"],
          "bindCredential": ["admin"],
          "searchScope": ["1"],
          "validatePasswordPolicy": ["false"],
          "trustEmail": ["true"],
          "useTrustStoreSpi": ["ldapsOnly"],
          "editMode": ["READ_ONLY"],
          "syncRegistrations": ["false"],
          "vendor": ["other"],
          "importEnabled": ["true"],
          "pagination": ["true"],
          "groupsDn": ["ou=Groups,dc=bionicpro,dc=com"],
          "groupMemberAttribute": ["member"],
          "groupNameLDAPAttribute": ["cn"],
          "groupObjectClasses": ["groupOfNames"],
          "membershipAttr": ["member"],
          "memberofAttr": ["memberOf"],
          "userRolesRetrieveStrategy": ["LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"],
          "groupMembershipFilterEnabled": ["false"],
          "kerberosRealm": [""],
          "serverPrincipal": [""],
          "keyTab": [""],
          "debug": ["false"],
          "allowKerberosAuthentication": ["false"],
          "useKerberosForPasswordAuthentication": ["false"],
          "referral": ["follow"]
        }
      }
    ]
